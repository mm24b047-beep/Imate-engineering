{
  "trailingSlash": false,
  "redirects": [
    { "source": "/about", "destination": "/profile", "permanent": true },
    { "source": "/about-us", "destination": "/profile", "permanent": true },
    { "source": "/awards", "destination": "/awards-certifications", "permanent": true },
    { "source": "/contact", "destination": "/contact-us", "permanent": true },
    { "source": "/schedule-an-appointment", "destination": "/contact-us", "permanent": true },
    { "source": "/thank-you", "destination": "/contact-us", "permanent": true },
    { "source": "/innovative-engineering-solutions", "destination": "/capabilities", "permanent": true },
    { "source": "/capabilities-of-imate-engineering", "destination": "/capabilities", "permanent": true },
    { "source": "/sitemap", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/category/:slug", "destination": "/blog", "permanent": true },
    { "source": "/dipi_media_category/off-road-vehicle-part", "destination": "/products#off-road", "permanent": true },
    { "source": "/dipi_media_category/compressor-parts", "destination": "/products#compressor", "permanent": true },
    { "source": "/dipi_media_category/machinery-parts", "destination": "/products#machinery", "permanent": true },
    { "source": "/dipi_media_category/cast-iron-stainless-steels-and-steel-valves", "destination": "/products#valves", "permanent": true },
    { "source": "/dipi_cpt_category/:slug", "destination": "/products", "permanent": true },
    { "source": "/:slug(audio-proprietorship-also-known-as-trader-is-owned(?:-\\d+)?|a-sole-proprietorship-also-known-as-trader-is-owned|the-nonprofit-landscape-varie-also-known-as-trader(?:-\\d+)?|link-proprietorship-also-known-as-trader-is-owned|video-proprietorship-also-known-as-trader-is-owned|quote-proprietorship-also-known-as-trader-is-owned)", "destination": "/blog", "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
