# ── Images ─────────────────────────────────────────────────────────────
# Images are served from public/images by default. Only set this to move them to a CDN:
# VITE_IMG_BASE=https://cdn.example.com/imate

# ── Enquiry form ───────────────────────────────────────────────────────
# Without an endpoint the form opens the visitor's mail client (and says so).
# Web3Forms (free): create a key at https://web3forms.com and set both lines.
# VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
# VITE_FORM_ACCESS_KEY=your-web3forms-access-key
#
# Formspree: VITE_FORM_ENDPOINT=https://formspree.io/f/yourFormId  (no access key)
# Own API:   VITE_FORM_ENDPOINT=https://your-api.example.com/enquiry  (expects JSON, replies 2xx on success)
